atterns":[]}', 'name': 'search_files'}, 'type': 'function'}], 'refusal': None}, response_metadata={'token_usage': {'completion_tokens': 31, 'prompt_tokens': 64248, 'total_tokens': 64279, 'completion_tokens_details': {'accepted_prediction_tokens': 0, 'audio_tokens': 0, 'reasoning_tokens': 0, 'rejected_prediction_tokens': 0}, 'prompt_tokens_details': {'audio_tokens': 0, 'cached_tokens': 64128}}, 'model_name': 'gpt-4o-2024-08-06', 'system_fingerprint': 'fp_90122d973c', 'id': 'chatcmpl-BUaBUJOZolY1FTNDHINC9wejtvNlX', 'service_tier': 'default', 'finish_reason': 'tool_calls', 'logprobs': None}, id='run--e303a547-e80e-4b54-a193-383a461be5b1-0', tool_calls=[{'name': 'search_files', 'args': {'path': '/home/streamlit-mcp-chat', 'pattern': 'DeepSeek', 'excludePatterns': []}, 'id': 'call_eTpX47OUdUKMMXbldmOAO9JT', 'type': 'tool_call'}], usage_metadata={'input_tokens': 64248, 'output_tokens': 31, 'total_tokens': 64279, 'input_token_details': {'audio': 0, 'cache_read': 64128}, 'output_token_details': {'audio': 0, 'reasoning': 0}}), ToolMessage(content='/home/streamlit-mcp-chat/deepseek_r1_summary.md', name='search_files', tool_call_id='call_eTpX47OUdUKMMXbldmOAO9JT'), AIMessage(content='', additional_kwargs={'tool_calls': [{'id': 'call_Jv87RHGkc9gwngSUz9hG2hvw', 'function': {'arguments': '{"path":"/home/streamlit-mcp-chat/deepseek_r1_summary.md"}', 'name': 'read_file'}, 'type': 'function'}], 'refusal': None}, response_metadata={'token_usage': {'completion_tokens': 29, 'prompt_tokens': 64300, 'total_tokens': 64329, 'completion_tokens_details': {'accepted_prediction_tokens': 0, 'audio_tokens': 0, 'reasoning_tokens': 0, 'rejected_prediction_tokens': 0}, 'prompt_tokens_details': {'audio_tokens': 0, 'cached_tokens': 64256}}, 'model_name': 'gpt-4o-2024-08-06', 'system_fingerprint': 'fp_90122d973c', 'id': 'chatcmpl-BUaBkR3FDrK9wZUbysv5mZf0fE1kj', 'service_tier': 'default', 'finish_reason': 'tool_calls', 'logprobs': None}, id='run--fa3e53e4-c1e2-43d9-96ec-217555335a9f-0', tool_calls=[{'name': 'read_file', 'args': {'path': '/home/streamlit-mcp-chat/deepseek_r1_summary.md'}, 'id': 'call_Jv87RHGkc9gwngSUz9hG2hvw', 'type': 'tool_call'}], usage_metadata={'input_tokens': 64300, 'output_tokens': 29, 'total_tokens': 64329, 'input_token_details': {'audio': 0, 'cache_read': 64256}, 'output_token_details': {'audio': 0, 'reasoning': 0}}), ToolMessage(content='\n# DeepSeek‑R1 Overview  \n*Last updated: 2025-05-07*\n\n## 1. What is DeepSeek‑R1?  \nDeepSeek‑R1 is a **reasoning‑centric large language model (LLM)** released in *January\u202f2025* by the Beijing‑based AI lab **DeepSeek**. It is the first public model series to:\n\n* Incentivize chain‑of‑thought reasoning **purely via Reinforcement Learning (RL)**, without an initial Supervised Fine‑Tuning (SFT) step.\xa0\ue200cite\ue202turn2view0\ue201  \n* Deliver performance **on par with OpenAI‑o1** across math, coding, and complex reasoning tasks while being fully open‑source under the MIT license.\xa0\ue200cite\ue202turn0search0\ue202turn0news29\ue201  \n\n## 2. Model Line‑up  \n\n| Variant | Total\xa0Params | Activated\xa0Params (MoE) | Context\xa0Len | Purpose |\n|---------|--------------|------------------------|-------------|---------|\n| **DeepSeek‑R1‑Zero** | 671\u202fB | 37\u202fB | 128\u202fK | RL‑only “cold‑start” model (no SFT) |\n| **DeepSeek‑R1** | 671\u202fB | 37\u202fB | 128\u202fK | Two SFT\xa0+\xa0two RL stages (flagship) |\n| **R1‑Distill (1.5\u202fB\xa0–\xa070\u202fB)** | 1.5‑70\u202fB | dense | 32\u202fK | Smaller dense checkpoints distilled from R1 | \ue200cite\ue202turn2view0\ue201\n\n> **MoE**\xa0= Mixture‑of‑Experts; only a subset of parameters are active per token.\n\n## 3. Training Pipeline (4‑Stage)  \n\n1. **SFT‑Seed\xa0Ⅰ** – Small curated instruction set to bootstrap capabilities.  \n2. **RL‑Discover\xa0Ⅰ** – Encourage the model to explore long chain‑of‑thoughts, yielding R1‑Zero.  \n3. **SFT‑Seed\xa0Ⅱ** – Incorporate cold‑start data to improve fluency & coverage.  \n4. **RL‑Align\xa0Ⅱ** – Align reasoning patterns with human preference & safety, producing R1.\xa0\ue200cite\ue202turn2view0\ue201  \n\n![](https://raw.githubusercontent.com/deepseek-ai/public-assets/main/r1_pipeline_diagram.png) <!-- placeholder diagram path -->\n\n## 4. Performance Highlights (May\u202f2025 Eval)  \n\n| Category | Benchmark | OpenAI‑o1 | DeepSeek‑R1 | GPT‑4o\xa00513 | Claude‑3.5 Sonnet |\n|----------|-----------|-----------|-------------|--------------|-------------------|\n| **Math** | AIME‑2024 (Pass@1) | 79.2 | **79.8** | 63.6 | 16.0 |\n| **Code** | Codeforces\xa0Rating | 2061 | **2029** | 1820 | 717 |\n| **Reason.** | MMLU (Pass@1) | 91.8 | **90.8** | 87.2 | 88.3 | \ue200cite\ue202turn5view0\ue201\n\n> 🔎 *DeepSeek‑R1 consistently scores within ~1‑2\u202f% of GPT‑4o on common reasoning tasks, and often surpasses OpenAI‑o1‑mini.*\n\n## 5. Distillation Breakthrough  \n\nDeepSeek demonstrates that **RL‑discovered reasoning traces can be transferred to smaller dense models**. The 32\u202fB Qwen‑based distillation *outperforms OpenAI‑o1‑mini* on several benchmarks while being **23× smaller**.\xa0\ue200cite\ue202turn2view0\ue201  \n\n## 6. Licensing & Ecosystem  \n\n* **MIT License** – Free for commercial and research use, including derivative works.\xa0\ue200cite\ue202turn0search0\ue201  \n* Official resources:  \n  * 📝 [arXiv\xa0paper\xa0(2501.12948)](https://arxiv.org/abs/2501.12948)  \n  * 🤗 [Hugging\u202fFace Model\xa0Card](https://huggingface.co/deepseek-ai/DeepSeek-R1)  \n  * 🌐 [Chat Demo](https://chat.deepseek.com) / [API Docs](https://api-docs.deepseek.com)  \n\n## 7. Strengths & Opportunities  \n\n* **Open & Reproducible** – First high‑end model (671\u202fB MoE) fully open‑sourced with weights.  \n* **Cost‑Efficient R&D** – RL pipeline slashes human‑label cost and compute vs. SFT‑heavy recipes.\xa0\ue200cite\ue202turn0news30\ue201  \n* **Benchmark Versatility** – Top‑tier results in math, code, multilingual reasoning, and Chinese tasks.  \n\n## 8. Limitations & Considerations  \n\n* **Safety / Policy Alignment** – RL alignment tuned primarily for English & Chinese; other languages may lag.  \n* **Censorship Concerns** – Being China‑based, hosted APIs may apply additional content filters.\xa0\ue200cite\ue202turn0news29\ue201  \n* **Resource Needs** – Full 671\u202fB MoE requires >\u200a2×\u202fA100‑80GB (or equivalent) for inference; distill models recommended for local use.  \n\n## 9. Getting Started Locally  \n\n```bash\npip install transformers accelerate\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\n\nmodel = AutoModelForCausalLM.from_pretrained("deepseek-ai/DeepSeek-R1",\n                                             device_map="auto", trust_remote_code=True)\ntok   = AutoTokenizer.from_pretrained("deepseek-ai/DeepSeek-R1")\n```\n\n> 🧩 *See the model card for FP8 & Flash‑Attention\xa02 tips.*\n\n## 10. Further Reading  \n\n1. DeepSeek‑R1 GitHub repo – training scripts & config.  \n2. Community eval notes on *r/LocalLLaMA*\xa0(“how good vs. o1”).\xa0  \n3. Business\xa0Insider & Financial\xa0Times coverage on the cost‑efficiency of R1.  \n\n---  \n©\xa02025-05-07\xa0DeepSeek‑AI\xa0/\xa0Community summaries. Feel free to reuse under MIT.\n', name='read_file', tool_call_id='call_Jv87RHGkc9gwngSUz9hG2hvw'), AIMessage(content='ローカルファイルに保存されている情報と、外部ソースの内容を比較すると、以下のような共通点と相違点が見えてきます。\n\n### 共通点\n1. **強化学習中心のアプローチ**:\n   - 両方のソースが確認しているように、DeepSeek-R1はスーパーバイザー付き微調整（SFT）を経ずに、強化学習だけで推論力を強化しようとしており、これはRLHF（強化学習による人間のフィードバック）からの大きな逸脱です。\n   \n2. **高い競争力**:\n   - ファイルと外部の両方のソースが、DeepSeek-R1がOpenAIのモデルと互角の性能を持ちながら、オープンソースであることを強調しています。\n\n### 相違点（観点と焦点の違い）\n1. **ディテールの焦点**:\n   - ファイルには、それぞれのモデルパラメータやトレーニングパイプラインの詳細なステップが含まれていますが、Zennの記事はより概念的で一般的な理解を提供し、特定のテクニック（例えば、コールドスタートや蒸留）に対する具体的な評価に焦点を当てています。\n\n2. **技術的なディスカッション**:\n   - ローカルファイルではサマリー的な情報が含まれているため、理論的背景よりも実践的な使用法とそのパフォーマンスに注目しています。一方、記事は研究の背景やその革新性について深く分析しています。\n\n### まとめ\n- 両方のソースは、DeepSeek-R1の取り組みが業界において新たな道筋を提示していることを認めています。特に、RLを核とした新たな推論モデルの開発と、その